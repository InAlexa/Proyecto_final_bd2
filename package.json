{
  "name": "sistema-clinico-multi-institucion",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"tsx watch server/index.ts\"",
    "build": "tsc -b && tsc --noEmit -p tsconfig.server.json && vite build",
    "check:db": "tsx server/check-databases.ts",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^14.5.0",
    "mongodb": "^6.20.0",
    "mysql2": "^3.24.6",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^7.0.0"
  }
}
