PORT=3001

# PostgreSQL del Hospital General. Usa los valores de DataGrip para evitar codificar la clave en una URL.
POSTGRES_URL=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=
POSTGRES_USER=
POSTGRES_PASSWORD=
# Déjalo en false para PostgreSQL local. Usa true si el servidor remoto exige TLS.
POSTGRES_SSL=false

# MySQL 8 del Centro Médico Pediátrico.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=centro_pediatrico
MYSQL_USER=root
MYSQL_PASSWORD=

# URI del cluster de MongoDB Atlas/Compass y nombre de la base de datos.
MONGODB_URI=
MONGODB_DB=laboratorio_clinico_db

# Firestore de la Clínica Odontológica. Descarga la clave del servicio y guárdala fuera del repositorio.
FIREBASE_PROJECT_ID=clinica-odontologica-bd2
GOOGLE_APPLICATION_CREDENTIALS=

# Usuarios locales de la aplicación. Define contraseñas propias en .env.
APP_HOSPITAL_PASSWORD=
APP_PEDIATRIA_PASSWORD=
APP_ODONTOLOGIA_PASSWORD=
APP_LABORATORIO_PASSWORD=
APP_ADMIN_PASSWORD=
